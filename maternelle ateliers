// ================================================================
// Workshop image helper - shows uploaded image or falls back to pictogram
// ================================================================
function WorkshopImage({ workshop, size = 'md' }: { workshop: Workshop; size?: 'sm' | 'md' | 'lg' }) {
  const sizeClasses = { sm: 'h-8 w-8 text-base', md: 'h-12 w-12 text-2xl', lg: 'h-16 w-16 text-3xl' }
  if (workshop.imageUrl) {
    return (
      <img
        src={workshop.imageUrl}
        alt={workshop.name}
        className={`${sizeClasses[size]} rounded-lg object-cover shrink-0`}
        onError={(e) => {
          (e.target as HTMLImageElement).style.display = 'none'
          ;(e.target as HTMLImageElement).nextElementSibling?.classList.remove('hidden')
        }}
      />
    )
  }
  return (
    <div className={`${sizeClasses[size]} rounded-lg bg-gray-100 border border-gray-200 flex items-center justify-center shrink-0`}>
      {workshop.pictogram || '\uD83D\uDCCC'}
    </div>
  )
}

// ================================================================
// MAIN PAGE
