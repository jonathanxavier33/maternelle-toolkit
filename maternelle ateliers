export async function POST(request: NextRequest) {
  try {
    const body = await request.json()
    const { title, period, studentIds, workshopIds, isClassWide, duplicateFrom, notes } = body

    // Duplication mode
    if (duplicateFrom) {
      const source = await db.sheet.findUnique({
        where: { id: duplicateFrom },
        include: { workshops: true },
      })
      if (!source) return NextResponse.json({ error: 'Fiche source introuvable' }, { status: 404 })

      const targetStudentIds = isClassWide
        ? (await db.student.findMany({ select: { id: true } })).map(s => s.id)
        : studentIds || [source.studentId].filter(Boolean)

      if (targetStudentIds.length === 0) {
        return NextResponse.json({ error: isClassWide ? 'Aucun eleve dans la classe' : 'Aucun eleve cible pour la duplication' }, { status: 400 })
      }

      const sheets = []
      for (const studentId of targetStudentIds) {
        const sheet = await db.sheet.create({
          data: {
            title: title || source.title,
            period: period || source.period,
            studentId,
            isClassWide: isClassWide !== undefined ? isClassWide : source.isClassWide,
            notes: notes !== undefined ? notes : source.notes,
            workshops: {
              create: source.workshops.map(sw => ({
                workshopId: sw.workshopId,
                evaluation: null, // reset evaluations on duplicate
              })),
            },
          },
          include: {
            student: true,
            workshops: { include: { workshop: true } },
          },
        })
        sheets.push(sheet)
      }
      return NextResponse.json(sheets, { status: 201 })
    }

    // Normal creation
    const periodNum = Number(period)
    if (!Number.isInteger(periodNum) || periodNum < 1 || periodNum > 5) {
      return NextResponse.json({ error: 'Periode invalide' }, { status: 400 })
    }
    if (!workshopIds || workshopIds.length === 0) {
      return NextResponse.json({ error: 'Selectionnez au moins un atelier' }, { status: 400 })
    }

    const targetStudentIds = isClassWide
      ? (await db.student.findMany({ select: { id: true } })).map(s => s.id)
      : studentIds || []

    if (targetStudentIds.length === 0) {
      return NextResponse.json(
        { error: isClassWide ? 'Aucun eleve dans la classe : ajoutez des eleves avant de generer une fiche' : 'Selectionnez au moins un eleve' },
        { status: 400 }
      )
    }

    const sheets = []
    for (const studentId of targetStudentIds) {
      const sheet = await db.sheet.create({
        data: {
          title: title || `Fiche - Periode ${periodNum}`,
          period: periodNum,
          studentId,
          isClassWide: !!isClassWide,
          notes: notes || null,
          workshops: {
            create: (workshopIds || []).map((workshopId: string) => ({
              workshopId,
            })),
          },
        },
        include: {
          student: true,
          workshops: { include: { workshop: true } },
        },
      })
      sheets.push(sheet)
    }

    return NextResponse.json(sheets, { status: 201 })
  } catch (error) {
    console.error('Sheet creation error:', error)
    return NextResponse.json({ error: 'Erreur lors de la creation de la fiche' }, { status: 500 })
  }
}

