    { key: 'workshops' as const, label: 'Banque d\'ateliers', icon: <Puzzle className="h-4 w-4" /> },
    { key: 'create' as const, label: 'Creer une fiche', icon: <ClipboardList className="h-4 w-4" /> },
    { key: 'sheets' as const, label: 'Fiches', icon: <FileText className="h-4 w-4" /> },
