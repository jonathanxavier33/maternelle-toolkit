  // AMELIORATION 3: Class statistics per period
  const periodSheets = store.sheets.filter(s => s.period === store.activePeriod)
  const classStats = {
    total: periodSheets.length,
    evaluated: periodSheets.reduce((acc, s) => acc + s.workshops.filter(sw => sw.evaluation && sw.evaluation !== 'non_evalue').length, 0),
    totalWorkshops: periodSheets.reduce((acc, s) => acc + s.workshops.length, 0),
    acquis: periodSheets.reduce((acc, s) => acc + s.workshops.filter(sw => sw.evaluation === 'acquis').length, 0),
    enCours: periodSheets.reduce((acc, s) => acc + s.workshops.filter(sw => sw.evaluation === 'en_cours').length, 0),
    nonAcquis: periodSheets.reduce((acc, s) => acc + s.workshops.filter(sw => sw.evaluation === 'non_acquis').length, 0),
