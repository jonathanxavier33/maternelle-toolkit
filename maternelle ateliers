export default function Home() {
  const store = useAppStore()

  const fetchData = useCallback(async () => {
    store.setIsLoading(true)
    try {
      const [studentsRes, workshopsRes, sheetsRes] = await Promise.all([
        fetch('/api/students'),
        fetch('/api/workshops'),
        fetch('/api/sheets'),
      ])
      const students = await studentsRes.json()
      const workshops = await workshopsRes.json()
      const sheets = await sheetsRes.json()
      store.setStudents(students)
      store.setWorkshops(workshops)
      store.setSheets(sheets)
    } catch {
      toast.error('Erreur lors du chargement des donnees')
    } finally {
      store.setIsLoading(false)
    }
  }, [])

  useEffect(() => { fetchData() }, [fetchData])

  const handleSeed = async () => {
    const res = await fetch('/api/seed', { method: 'POST' })
    const data = await res.json()
    toast.success(data.message)
    fetchData()
  }

  const addStudent = async (firstName: string, lastName: string, level: string) => {
    try {
      const res = await fetch('/api/students', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ firstName, lastName, level }),
      })
      if (!res.ok) { const err = await res.json().catch(() => ({})); throw new Error(err.error || 'Erreur serveur') }
      const student = await res.json()
      store.setStudents([...store.students, student])
      toast.success(`${firstName} ${lastName} ajoute(e) en ${level}`)
    } catch (e) {
      toast.error(e instanceof Error ? e.message : 'Erreur lors de l\'ajout de l\'eleve')
    }
  }

  const deleteStudent = async (id: string, name: string) => {
    try {
      const res = await fetch(`/api/students?id=${id}`, { method: 'DELETE' })
      if (!res.ok) throw new Error('Erreur serveur')
      store.setStudents(store.students.filter(s => s.id !== id))
      store.setSelectedStudentIds(store.selectedStudentIds.filter(i => i !== id))
      toast.success(`${name} supprime(e)`)
    } catch {
      toast.error('Erreur lors de la suppression de l\'eleve')
    }
  }

  const addWorkshop = async (data: { name: string; description: string; domain: string; subdomain: string; pictogram: string; imageUrl: string | null; period: number }) => {
    try {
      const res = await fetch('/api/workshops', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data),
      })
      if (!res.ok) { const err = await res.json().catch(() => ({})); throw new Error(err.error || 'Erreur serveur') }
      const workshop = await res.json()
      store.setWorkshops([...store.workshops, workshop])
      toast.success(`Atelier \u00AB ${data.name} \u00BB ajoute`)
    } catch (e) {
      toast.error(e instanceof Error ? e.message : 'Erreur lors de l\'ajout de l\'atelier')
    }
  }

  const deleteWorkshop = async (id: string, name: string) => {
    await fetch(`/api/workshops?id=${id}`, { method: 'DELETE' })
    store.setWorkshops(store.workshops.filter(w => w.id !== id))
    store.setSelectedWorkshopIds(store.selectedWorkshopIds.filter(i => i !== id))
    toast.success(`Atelier \u00AB ${name} \u00BB supprime`)
  }

  const generateSheets = async (isClassWide: boolean) => {
    if (!isClassWide && store.selectedStudentIds.length === 0) { toast.error('Selectionnez au moins un eleve'); return }
    if (store.selectedWorkshopIds.length === 0) { toast.error('Selectionnez au moins un atelier'); return }
    store.setIsLoading(true)
    try {
      const res = await fetch('/api/sheets', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: `Fiches - Periode ${store.activePeriod}`,
          period: store.activePeriod, studentIds: store.selectedStudentIds,
          workshopIds: store.selectedWorkshopIds, isClassWide,
        }),
      })
      if (!res.ok) { const err = await res.json().catch(() => ({})); throw new Error(err.error || 'Erreur serveur') }
      const newSheets = await res.json()
      store.setSheets([...newSheets, ...store.sheets])
      store.setActiveTab('sheets')
      toast.success(`${newSheets.length} fiche(s) generee(s) !`)
    } catch (e) { toast.error(e instanceof Error ? e.message : 'Erreur lors de la generation') }
    finally { store.setIsLoading(false) }
  }

  const duplicateSheet = async (sheet: SheetFull) => {
    store.setIsLoading(true)
    try {
      const res = await fetch('/api/sheets', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          duplicateFrom: sheet.id,
          period: store.activePeriod,
          isClassWide: sheet.isClassWide,
          studentIds: sheet.studentId ? [sheet.studentId] : undefined,
        }),
      })
      const newSheets = await res.json()
      store.setSheets([...newSheets, ...store.sheets])
      toast.success(`Fiche dupliquee pour la ${PERIODES[store.activePeriod - 1].label} !`)
    } catch { toast.error('Erreur lors de la duplication') }
    finally { store.setIsLoading(false) }
  }

  const updateEvaluation = async (sheetWorkshopId: string, evaluation: string) => {
    const res = await fetch('/api/sheets', {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sheetWorkshopId, evaluation }),
    })
    const updated = await res.json()
    store.setSheets(store.sheets.map(s => ({
      ...s, workshops: s.workshops.map(sw => sw.id === updated.id ? { ...sw, evaluation: updated.evaluation } : sw),
    })))
  }

  const updateSheetNotes = async (sheetId: string, notes: string) => {
    const res = await fetch('/api/sheets', {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sheetId, notes }),
    })
    const updated = await res.json()
    store.setSheets(store.sheets.map(s => s.id === updated.id ? updated : s))
  }

  const deleteSheet = async (id: string) => {
    await fetch(`/api/sheets?id=${id}`, { method: 'DELETE' })
