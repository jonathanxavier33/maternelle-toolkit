// ================================================================
// MAIN PAGE
// ================================================================
export default function Home() {
  const store = useAppStore()

  const fetchData = useCallback(async () => {
    store.setIsLoading(true)
    try {
      const [studentsRes, workshopsRes, sheetsRes] = await Promise.all([
        fetch('/api/students'),
        fetch('/api/workshops'),
        fetch('/api/sheets'),
      ])
      const students = await studentsRes.json()
      const workshops = await workshopsRes.json()
      const sheets = await sheetsRes.json()
      store.setStudents(students)
      store.setWorkshops(workshops)
      store.setSheets(sheets)
    } catch {
      toast.error('Erreur lors du chargement des données')
    } finally {
      store.setIsLoading(false)
    }
  }, [])

  useEffect(() => { fetchData() }, [fetchData])

  const handleSeed = async () => {
    const res = await fetch('/api/seed', { method: 'POST' })
    const data = await res.json()
    toast.success(data.message)
    fetchData()
  }

  const addStudent = async (firstName: string, lastName: string, level: string) => {
    const res = await fetch('/api/students', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ firstName, lastName, level }),
    })
    const student = await res.json()
    store.setStudents([...store.students, student])
    toast.success(`${firstName} ${lastName} ajouté(e) en ${level}`)
  }

  const deleteStudent = async (id: string, name: string) => {
    await fetch(`/api/students?id=${id}`, { method: 'DELETE' })
    store.setStudents(store.students.filter(s => s.id !== id))
    store.setSelectedStudentIds(store.selectedStudentIds.filter(i => i !== id))
    toast.success(`${name} supprimé(e)`)
  }

  const addWorkshop = async (data: { name: string; description: string; domain: string; subdomain: string; period: number; pictogram: string }) => {
    const res = await fetch('/api/workshops', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data),
    })
    const workshop = await res.json()
    store.setWorkshops([...store.workshops, workshop])
    toast.success(`Atelier « ${data.name} » ajouté`)
  }

  const generateSheets = async (isClassWide: boolean) => {
    if (!isClassWide && store.selectedStudentIds.length === 0) { toast.error('Sélectionnez au moins un élève'); return }
    if (store.selectedWorkshopIds.length === 0) { toast.error('Sélectionnez au moins un atelier'); return }
    store.setIsLoading(true)
    try {
      const res = await fetch('/api/sheets', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: `Fiches - Période ${store.activePeriod}`,
          period: store.activePeriod, studentIds: store.selectedStudentIds,
          workshopIds: store.selectedWorkshopIds, isClassWide,
        }),
      })
      const newSheets = await res.json()
      store.setSheets([...newSheets, ...store.sheets])
      store.setActiveTab('sheets')
      toast.success(`${newSheets.length} fiche(s) générée(s) !`)
    } catch { toast.error('Erreur lors de la génération') }
    finally { store.setIsLoading(false) }
  }

  const updateEvaluation = async (sheetWorkshopId: string, evaluation: string) => {
    const res = await fetch('/api/sheets', {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sheetWorkshopId, evaluation }),
    })
    const updated = await res.json()
    store.setSheets(store.sheets.map(s => ({
      ...s, workshops: s.workshops.map(sw => sw.id === updated.id ? { ...sw, evaluation: updated.evaluation } : sw),
    })))
  }

  const deleteSheet = async (id: string) => {
    await fetch(`/api/sheets?id=${id}`, { method: 'DELETE' })
    store.setSheets(store.sheets.filter(s => s.id !== id))
    if (store.previewingSheetId === id) store.setPreviewingSheetId(null)
    toast.success('Fiche supprimée')
  }

  const filteredWorkshops = store.workshops.filter(w => {
    const periodMatch = w.period === store.activePeriod
    const domainMatch = store.workshopFilter === 'all' || w.domain === store.workshopFilter
    const searchMatch = !store.workshopSearch ||
      w.name.toLowerCase().includes(store.workshopSearch.toLowerCase()) ||
      (w.description && w.description.toLowerCase().includes(store.workshopSearch.toLowerCase()))
    return periodMatch && domainMatch && searchMatch
  })

