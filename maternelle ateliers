export async function PUT(request: NextRequest) {
  const body = await request.json()
  const { sheetWorkshopId, evaluation, sheetId, notes } = body

  // Update sheet notes
  if (sheetId && notes !== undefined) {
    const updated = await db.sheet.update({
      where: { id: sheetId },
      data: { notes },
      include: {
        student: true,
        workshops: { include: { workshop: true } },
      },
    })
    return NextResponse.json(updated)
  }

  // Update evaluation
  if (!sheetWorkshopId || !evaluation) {
    return NextResponse.json({ error: 'Donnees manquantes' }, { status: 400 })
  }

  const updated = await db.sheetWorkshop.update({
    where: { id: sheetWorkshopId },
    data: { evaluation },
    include: { workshop: true },
  })

  return NextResponse.json(updated)
}

