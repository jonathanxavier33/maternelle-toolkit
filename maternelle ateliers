/* ============================================================ */
function SheetPreview({ sheet, onEvaluate, onDelete, onDuplicate, onUpdateNotes, onBack }: {
  sheet: SheetFull; onEvaluate: (id: string, ev: string) => void; onDelete: () => void; onDuplicate: () => void; onUpdateNotes: (n: string) => void; onBack: () => void
}) {
  const [viewMode, setViewMode] = useState<'cover' | 'tracking' | 'evaluate'>('cover')
  const [editingNotes, setEditingNotes] = useState(false)
  const [notesText, setNotesText] = useState(sheet.notes || '')
  const studentName = sheet.student ? `${sheet.student.firstName} ${sheet.student.lastName}` : 'Classe entiere'
  const byDomain = sheet.workshops.reduce<Record<string, typeof sheet.workshops>>((acc, sw) => {
    if (!acc[sw.workshop.domain]) acc[sw.workshop.domain] = []
    acc[sw.workshop.domain].push(sw)
    return acc
  }, {})
  const evalCounts = {
    acquis: sheet.workshops.filter(sw => sw.evaluation === 'acquis').length,
    en_cours: sheet.workshops.filter(sw => sw.evaluation === 'en_cours').length,
    non_acquis: sheet.workshops.filter(sw => sw.evaluation === 'non_acquis').length,
    non_evalue: sheet.workshops.filter(sw => !sw.evaluation || sw.evaluation === 'non_evalue').length,
  }

  const handlePrint = () => {
    window.print()
  }

  const handleSaveNotes = () => {
    onUpdateNotes(notesText)
    setEditingNotes(false)
  }

  return (
    <div className="space-y-4">
      <div className="flex flex-wrap items-center gap-2">
        <Button variant="ghost" size="sm" onClick={onBack}><ArrowLeft className="h-4 w-4 mr-1" /> Retour</Button>
        <Separator orientation="vertical" className="h-5" />
        <Button variant={viewMode === 'cover' ? 'default' : 'outline'} size="sm" className={viewMode === 'cover' ? 'bg-teal-700 hover:bg-teal-800' : ''} onClick={() => setViewMode('cover')}>Page de garde</Button>
        <Button variant={viewMode === 'tracking' ? 'default' : 'outline'} size="sm" className={viewMode === 'tracking' ? 'bg-teal-700 hover:bg-teal-800' : ''} onClick={() => setViewMode('tracking')}>Fiche eleve</Button>
        <Button variant={viewMode === 'evaluate' ? 'default' : 'outline'} size="sm" className={viewMode === 'evaluate' ? 'bg-teal-700 hover:bg-teal-800' : ''} onClick={() => setViewMode('evaluate')}>Evaluation ({sheet.workshops.length})</Button>
        <div className="ml-auto flex gap-2">
          {/* AMELIORATION 5: Print button */}
          <Button variant="outline" size="sm" onClick={handlePrint}><Printer className="h-3.5 w-3.5 mr-1" /> Imprimer</Button>
          <Button variant="outline" size="sm" onClick={onDuplicate}><Copy className="h-3.5 w-3.5 mr-1" /> Dupliquer</Button>
          <Button variant="ghost" size="sm" className="text-red-500 hover:text-red-600" onClick={onDelete}><Trash2 className="h-4 w-4 mr-1" /> Supprimer</Button>
        </div>
      </div>

      {viewMode === 'cover' && <StudentCoverPage sheet={sheet} />}

      {viewMode === 'tracking' && <StudentTrackingSheet sheet={sheet} />}

      {viewMode === 'evaluate' && (
        <div className="space-y-4">
          {/* Summary bar */}
          <Card className="bg-gradient-to-r from-teal-50 to-emerald-50 border-teal-200">
            <CardContent className="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div className="flex items-center gap-3">
                <div className="h-10 w-10 rounded-full bg-gradient-to-br from-teal-400 to-emerald-500 flex items-center justify-center text-white font-bold text-sm">
                  {sheet.student ? `${sheet.student.firstName[0]}${sheet.student.lastName[0]}` : 'CL'}
                </div>
                <div>
                  <p className="font-semibold text-gray-800">{studentName}</p>
                  <p className="text-xs text-gray-500">{PERIODES[sheet.period - 1].label} &middot; {sheet.workshops.length} ateliers</p>
                </div>
              </div>
              <div className="flex gap-3 text-center">
                {EVALUATION_OPTIONS.map(opt => (
                  <div key={opt.value}>
                    <p className={`text-lg font-bold ${opt.value === 'acquis' ? 'text-green-600' : opt.value === 'en_cours' ? 'text-yellow-600' : opt.value === 'non_acquis' ? 'text-red-600' : 'text-gray-400'}`}>
                      {evalCounts[opt.value as keyof typeof evalCounts]}
                    </p>
                    <p className="text-[10px] text-gray-500">{opt.label}</p>
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>

          {/* AMELIORATION 5: Notes section */}
          <Card>
            <CardContent className="p-4">
              <div className="flex items-center justify-between mb-2">
                <h3 className="text-sm font-semibold text-gray-800 flex items-center gap-2">
                  <StickyNote className="h-4 w-4 text-teal-700" /> Observations / Notes
                </h3>
                {!editingNotes && (
                  <Button variant="link" size="sm" className="h-auto p-0 text-xs" onClick={() => { setNotesText(sheet.notes || ''); setEditingNotes(true) }}>
                    {sheet.notes ? 'Modifier' : 'Ajouter'}
                  </Button>
                )}
              </div>
              {editingNotes ? (
                <div className="space-y-2">
                  <Textarea value={notesText} onChange={(e) => setNotesText(e.target.value)} placeholder="Ajoutez vos observations ici..." rows={3} className="text-sm" />
                  <div className="flex gap-2 justify-end">
                    <Button variant="outline" size="sm" onClick={() => setEditingNotes(false)}>Annuler</Button>
                    <Button size="sm" className="bg-teal-700 hover:bg-teal-800 text-white" onClick={handleSaveNotes}>Enregistrer</Button>
                  </div>
                </div>
              ) : sheet.notes ? (
                <p className="text-sm text-gray-600 whitespace-pre-wrap">{sheet.notes}</p>
              ) : (
                <p className="text-xs text-gray-400 italic">Aucune note pour le moment.</p>
              )}
            </CardContent>
          </Card>

          {/* Workshops by domain with images */}
          {Object.entries(byDomain).map(([domain, items]) => {
            const info = DOMAIN_INFO[domain]
            return (
              <Card key={domain}>
                <CardContent className="p-4 space-y-2">
                  <h3 className={`text-sm font-semibold flex items-center gap-2 ${info?.color || ''}`}>
                    <span className="text-lg">{info?.icon}</span> {info?.short || domain}
                  </h3>
                  {items.map(sw => (
                    <div key={sw.id} className="flex flex-col sm:flex-row sm:items-center gap-2 p-2.5 rounded-lg hover:bg-gray-50 border border-transparent hover:border-gray-100">
                      <div className="flex items-center gap-2.5 flex-1 min-w-0">
                        <WorkshopImage workshop={sw.workshop} size="sm" />
                        <div className="min-w-0">
                          <p className="text-sm font-medium text-gray-800">{sw.workshop.name}</p>
                          {sw.workshop.description && <p className="text-xs text-gray-400 line-clamp-1">{sw.workshop.description}</p>}
                        </div>
                      </div>
                      <div className="flex gap-1 shrink-0">
                        {EVALUATION_OPTIONS.map(opt => (
                          <Button key={opt.value} variant={sw.evaluation === opt.value ? 'default' : 'outline'} size="sm"
                            className={`text-[10px] h-7 px-2 ${sw.evaluation === opt.value ? 'bg-teal-700 hover:bg-teal-800 text-white' : ''}`}
                            onClick={() => onEvaluate(sw.id, opt.value)}>
                            {opt.emoji} {opt.label}
                          </Button>
                        ))}
                      </div>
                    </div>
                  ))}
                </CardContent>
              </Card>
            )
          })}
        </div>
      )}
    </div>
  )
}
